<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Typography Styles -->
    <style name="SakaTypography.Title1" parent="TextAppearance.MaterialComponents.Headline4">
        <item name="android:textSize">@dimen/saka_text_title1</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/saka_black</item>
    </style>

    <style name="SakaTypography.Title2" parent="TextAppearance.MaterialComponents.Headline5">
        <item name="android:textSize">@dimen/saka_text_title2</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/saka_black</item>
    </style>

    <style name="SakaTypography.Body1" parent="TextAppearance.MaterialComponents.Body1">
        <item name="android:textSize">@dimen/saka_text_body1</item>
        <item name="android:textColor">@color/saka_black</item>
    </style>

    <style name="SakaTypography.Body2" parent="TextAppearance.MaterialComponents.Body2">
        <item name="android:textSize">@dimen/saka_text_body2</item>
        <item name="android:textColor">@color/saka_grey</item>
    </style>

    <!-- Component Styles -->
    <style name="SakaButton.Primary" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/saka_primary</item>
        <item name="android:textColor">@color/saka_white</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Saka.Pill</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="SakaTextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/saka_primary</item>
        <item name="boxCornerRadiusTopStart">@dimen/saka_radius_m</item>
        <item name="boxCornerRadiusTopEnd">@dimen/saka_radius_m</item>
        <item name="boxCornerRadiusBottomStart">@dimen/saka_radius_m</item>
        <item name="boxCornerRadiusBottomEnd">@dimen/saka_radius_m</item>
        <item name="hintTextColor">@color/saka_primary</item>
    </style>

    <style name="SakaCard" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">@dimen/saka_radius_l</item>
        <item name="cardElevation">4dp</item>
        <item name="android:layout_margin">8dp</item>
    </style>

    <style name="SakaNavigationBar" parent="">
        <item name="android:background">@color/saka_white</item>
        <item name="android:elevation">0dp</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.Saka.Pill" parent="">
        <item name="cornerSize">50%</item>
    </style>
</resources>
