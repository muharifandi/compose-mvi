<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/splash_fragment">

    <!-- SPLASH -->
    <fragment
        android:id="@+id/splash_fragment"
        android:name="com.muh.arifandi.dicoding.features.splash.ui.SplashFragment"
        android:label="SplashFragment" />

    <!-- INTRO / ONBOARDING -->
    <fragment
        android:id="@+id/intro_fragment"
        android:name="com.muh.arifandi.dicoding.features.intro.ui.IntroFragment"
        android:label="IntroFragment">
        <deepLink app:uri="saka://intro" />
    </fragment>

    <!-- AUTH FLOW -->
    <fragment
        android:id="@+id/login_fragment"
        android:name="com.muh.arifandi.dicoding.features.login.ui.LoginFragment"
        android:label="LoginFragment">
        <deepLink app:uri="saka://login" />
    </fragment>

    <!-- MAIN FLOW (Bottom Nav / Drawer) -->
    <fragment
        android:id="@+id/navigation_home"
        android:name="com.muh.arifandi.dicoding.features.home.ui.HomeFragment"
        android:label="Home">
        <deepLink app:uri="saka://home" />
    </fragment>

    <fragment
        android:id="@+id/navigation_jobs"
        android:name="com.muh.arifandi.dicoding.features.jobs.ui.JobsFragment"
        android:label="Jobs">
        <deepLink app:uri="saka://jobs" />
    </fragment>

    <fragment
        android:id="@+id/navigation_history"
        android:name="com.muh.arifandi.dicoding.features.history.ui.HistoryFragment"
        android:label="History">
        <deepLink app:uri="saka://history" />
    </fragment>

    <fragment
        android:id="@+id/navigation_profile"
        android:name="com.muh.arifandi.dicoding.features.profile.ui.ProfileFragment"
        android:label="Profile">
        <deepLink app:uri="saka://profile" />
    </fragment>

    <!-- OTHERS -->
    <fragment
        android:id="@+id/navigation_network"
        android:name="com.muh.arifandi.dicoding.features.network.ui.NetworkFragment"
        android:label="Network" />

</navigation>
